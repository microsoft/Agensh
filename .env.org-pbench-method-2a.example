# =================================================================
# .env.org-pbench-method-2a.example — ProgramBench 1-team + shared board
# ("method-2a", sweep 6.11). This is the arm this snapshot ships.
#
# Usage:
#     cp .env.org-pbench-method-2a.example .env.org-pbench-method-2a-myrun
#     vim .env.org-pbench-method-2a-myrun          # fill every CHANGEME
#     TASK=ffmpeg__ffmpeg.360a402 HOURS=6 \
#       PROFILE=org-pbench-method-2a-myrun bash scripts/pbench_run_1team.sh
#
# The PROFILE name is load-bearing: the Makefile's `org-pbench-method-2a-%`
# rule is what layers docker-compose.pbench.yml + -1team.yml + -1team-board.yml.
# Rename the profile out of that prefix and you silently get a different topology.
#
# To mint many profiles for a sweep, fill this in as `.env.org-pbench-method-2a`
# (no suffix) and run `SLUG_BASE=s611 scripts/pbench_gen_env_sweep62.sh`; it
# allocates ports, subnets, data dirs and AGENT_IMAGE per task for you.
# =================================================================

ORG_NAME=pbench
# Must match the filename suffix: .env.<PROFILE>
PROFILE=org-pbench-method-2a-myrun

# Host ports. One free pair per concurrent run (Mattermost is conventionally +2).
EDGE_HTTP_PORT=15800
EDGE_MM_PORT=15802
EDGE_DOMAIN=localhost
MATTERMOST_SITE_URL=http://localhost:15802

# Container state. One directory per run; `make clean PROFILE=...` wipes it.
# Keep it inside this checkout so two trees on one host never share state.
DATA_ROOT=./.claude-team-data

# --- credentials (CHANGEME: any strong values) ---------------------------
GITEA_ADMIN_USER=chairman
GITEA_ADMIN_PASSWORD=CHANGEME

MYSQL_ROOT_PASSWORD=CHANGEME
MYSQL_PASSWORD=CHANGEME

SECRET_SERVICE_INTERNAL_AUTH=CHANGEME

MATTERMOST_ADMIN_USER=mmadmin
MATTERMOST_ADMIN_PASSWORD=CHANGEME

# --- repo / workflow -----------------------------------------------------
REPOS=main
# 1-team has no reviewer and no approval stage: a worker merges its own PR.
REQUIRED_APPROVALS=0
# How long a mini-router waits on a silent agent before nudging it (ms).
MINI_ROUTER_STUCK_MS=1200000

# --- model path ----------------------------------------------------------
# Agents talk ONLY to the in-cluster egress proxy. ANTHROPIC_API_KEY stays a
# placeholder on purpose: strip_metadata_proxy.py discards whatever the agent
# sends and injects UPSTREAM_AUTH_TOKEN itself, so no agent container ever
# holds a real credential. Do not put your token in ANTHROPIC_API_KEY.
AGENT_KIND=claude
ANTHROPIC_BASE_URL=http://egress-proxy:4180
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_API_KEY=sk-1234

# egress-proxy -> your real upstream.
PBENCH_LLM_UPSTREAM=https://api.anthropic.com
UPSTREAM_AUTH_TOKEN=CHANGEME
# "bearer" sends Authorization: Bearer <token>; "x-api-key" sends x-api-key.
UPSTREAM_AUTH_STYLE=bearer

# --- agent image ---------------------------------------------------------
# Built FROM this task's own ProgramBench cleanroom by
# scripts/pbench_build_pertask_images.sh, so the agent's compiler, libraries and
# crate versions are the grader's by construction. The name is derived from the
# repo half of the instance id: ffmpeg__ffmpeg.360a402 -> omcgitea-agent-ffmpeg.
# One image per task — change this when you change TASK.
AGENT_IMAGE=omcgitea-agent-ffmpeg:pertask-claude

# --- topology ------------------------------------------------------------
# 1-team merges the director and lead into one agent, so both point at it.
PBENCH_DIRECTOR_AGENT=pbench-team1-lead
PBENCH_AUDITOR_AGENT=pbench-team1-lead

# Anti-cheat: agents run non-root so the reference binary at
# /opt/pbench/executable stays root:root 0111 — executable, not readable.
# Leave these set. Unsetting them lets an agent dump the binary it is supposed
# to reverse-engineer, which voids the run.
ACP_CHILD_UID=10000
ACP_CHILD_GID=10000

# --- networks ------------------------------------------------------------
# Three pinned /24s per stack. Docker's built-in pool holds only 31 subnets and
# each stack needs three, so concurrent runs cannot be auto-allocated — pick a
# non-overlapping triple per run.
PBENCH_SUBNET_DEFAULT=10.190.1.0/24
PBENCH_SUBNET_EGRESS=10.190.2.0/24
PBENCH_SUBNET_EDGE=10.190.3.0/24

# --- optional ------------------------------------------------------------
# The generated compose base carries the full 5-team roster and the 1team
# overlay disables all but team1's lead + 4 workers, which is why these are not
# required. Set them to emit a leaner base instead.
# PBENCH_TEAMS=1
# PBENCH_WORKERS_PER_TEAM=4

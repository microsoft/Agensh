# =================================================================
# .env.org.example — single-instance "org" profile for the frozen
# 37-agent prod template (docker/docker-compose.prod.yml).
#
# Usage:
#     cp .env.org.example .env.org-foo
#     vim .env.org-foo                 # fill ORG_NAME, PORT_BASE, secrets
#     make up PROFILE=org-foo          # Makefile auto-selects prod template
#
# To run multiple instances on one host, copy this file once per org and
# vary ORG_NAME + PORT_BASE (and DATA_ROOT if you want a different
# bind-mount root). Each instance is isolated:
#   - docker --project-name omcgitea-org-<name>  (own network)
#   - separate Gitea/Mattermost/MySQL/agents
#   - separate data dir under DATA_ROOT/${PROFILE}/
# =================================================================

# ---- REQUIRED ----

# Instance identifier. Becomes prefix for every agent name (e.g.
# acme-director, acme-team1-lead, ...). Also goes into GITEA_ORG and
# becomes Mattermost team name. Lowercase + alphanumeric + dash, no
# slashes. Treat as immutable per instance.
ORG_NAME=acme

# Host port base. Edge nginx publishes Gitea HTTP on PORT_BASE and
# Mattermost on PORT_BASE+2. Reserve 10 ports per instance to be safe
# (e.g. acme=3300, beta=3310, gamma=3320, ...).
EDGE_HTTP_PORT=3300
EDGE_MM_PORT=3302
EDGE_DOMAIN=localhost

# Mattermost site URL — agents see this; must be reachable from agent
# containers. Use ${EDGE_DOMAIN}:${EDGE_MM_PORT} or full external URL.
MATTERMOST_SITE_URL=http://localhost:3302

# Profile = ${ORG_NAME} prefixed with org- (matches Makefile dispatcher).
# Used by docker compose --project-name and by data-dir paths.
PROFILE=org-acme

# Where this instance's bind-mounts live on the host. Default keeps it
# alongside other profiles under ../.claude-team-data/${PROFILE}/.
DATA_ROOT=../.claude-team-data

# ---- SECRETS (generate fresh per instance — do NOT share across instances) ----
# Easy way to mint:
#     openssl rand -hex 32   # for MYSQL / SECRET_SERVICE
#     openssl rand -base64 18 # for passwords

GITEA_ADMIN_USER=chairman
GITEA_ADMIN_PASSWORD=CHANGE_ME_strong_password

MYSQL_ROOT_PASSWORD=CHANGE_ME_hex32
MYSQL_PASSWORD=CHANGE_ME_hex32

SECRET_SERVICE_INTERNAL_AUTH=CHANGE_ME_hex32

MATTERMOST_ADMIN_USER=mmadmin
MATTERMOST_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ---- ANTHROPIC BACKEND ----
ANTHROPIC_BASE_URL=https://your-anthropic-endpoint.example
ANTHROPIC_API_KEY=CHANGE_ME

# ---- OPTIONAL TUNING (defaults baked into compose; uncomment to override) ----
# REQUIRED_APPROVALS=1
# REPOS=main
# MINI_ROUTER_STUCK_MS=1200000

# =================================================================
# .env.pbench-sim.example — AGENT_KIND=sim profile.
#
# Runs the whole pbench chain with NO LLM: the agents speak real ACP to their
# mini-routers, call the real gitea / mattermost / board MCP servers through
# mcp-notice-shim, and honour the real UEM contract — but no model is ever
# contacted.
#
# Usage:
#     cp .env.pbench-sim.example .env.pbench-sim
#     vim .env.pbench-sim                        # fill every CHANGEME
#     sudo docker build -t omcgitea-sim-agent:local -f docker/sim-agent/Dockerfile .
#     TASK=danmar__cppcheck.0a5b103 HOURS=0.25 SKIP_EVAL=1 \
#       PROFILE=pbench-sim bash scripts/pbench_run.sh
#
# The `pbench-` prefix is load-bearing: the Makefile accepts no other profile.
# =================================================================

ORG_NAME=pbench
PROFILE=pbench-sim

# Ports clear of the generated profiles (18000-18590, 22000-22190).
EDGE_HTTP_PORT=19400
EDGE_MM_PORT=19402
EDGE_DOMAIN=localhost
MATTERMOST_SITE_URL=http://localhost:19402

# MUST BE ABSOLUTE. compose resolves a relative bind-mount source against the
# COMPOSE FILE's directory (docker/), while the Makefile's prep-mm-dirs resolves
# it against the repo root — so a relative value splits the stack's state across
# two directories. The dirs compose then auto-creates are root-owned, mattermost
# runs as uid 2000, cannot write config.json, and the stack dies with
# "dependency failed to start: mattermost is unhealthy" — which reads as an
# infra flake, not a config error. scripts/pbench_gen_env.sh writes an
# absolute path for exactly this reason.
DATA_ROOT=/CHANGEME/absolute/path/to/this/checkout/.claude-team-data

# --- credentials (CHANGEME: any strong values; this stack is throwaway) ---
GITEA_ADMIN_USER=chairman
GITEA_ADMIN_PASSWORD=CHANGEME

MYSQL_ROOT_PASSWORD=CHANGEME
MYSQL_PASSWORD=CHANGEME

SECRET_SERVICE_INTERNAL_AUTH=CHANGEME

MATTERMOST_ADMIN_USER=mmadmin
MATTERMOST_ADMIN_PASSWORD=CHANGEME

# --- repo / workflow -----------------------------------------------------
REPOS=main
REQUIRED_APPROVALS=0
MINI_ROUTER_STUCK_MS=1200000

# CI gate. Leave at 1 for a full-chain check — the sim opens real PRs, so the
# closes-issue-check job is what proves act_runner is wired. Set 0 for the
# no-gate topology.
PBENCH_CI_GATE=1

# --- the sim -------------------------------------------------------------
AGENT_KIND=sim
AGENT_IMAGE=omcgitea-sim-agent:local
# The router must admit `sim` in its ACP_SESSION_NAMESPACE union, so build it
# from this tree. Pinning a SEPARATE tag rather than
# rebuilding omcgitea-mini-router:local keeps other stacks on this host — which
# share that tag — on the image they were started with.
#   sudo docker build -t omcgitea-mini-router:sim mini-router
MINI_ROUTER_IMAGE=omcgitea-mini-router:sim

# Productive turns per agent before it goes quiet. The run's success condition
# is every agent reaching this, not the wall clock.
PBENCH_SIM_TURNS=4
# Simulated per-tool latency. 0 makes the run as fast as the stack allows;
# raise it to spread load out over the budget.
PBENCH_SIM_THINK_MS=250
# Unset = fully deterministic. Set any string to get reproducible jitter, which
# is what makes a merge race debuggable rather than a one-off.
# PBENCH_SIM_SEED=sim1

# --- model path (present, never contacted) -------------------------------
# compose requires all three to be set; the sim makes zero LLM calls, so the
# egress proxy stays at zero requests. PBENCH_LLM_UPSTREAM is likewise required
# by the egress-proxy service definition but is never dialled.
ANTHROPIC_BASE_URL=http://egress-proxy:4180
ANTHROPIC_MODEL=sim-no-model
ANTHROPIC_API_KEY=sk-unused-by-sim
PBENCH_LLM_UPSTREAM=http://127.0.0.1:1
UPSTREAM_AUTH_TOKEN=unused-by-sim
UPSTREAM_AUTH_STYLE=bearer
UPSTREAM_PATH_OVERRIDE=

# --- topology ------------------------------------------------------------
PBENCH_WORKERS_PER_TEAM=4
PBENCH_DIRECTOR_AGENT=pbench-worker1
PBENCH_AUDITOR_AGENT=pbench-worker1

# Anti-cheat stays ON even in sim: it is what makes the sim exercise the same
# uid-10000 privilege drop the real path uses. Unsetting it would quietly test
# a different container.
ACP_CHILD_UID=10000
ACP_CHILD_GID=10000

# --- networks ------------------------------------------------------------
# Three pinned /24s, clear of the generated profiles (10.199, 10.200, 10.216).
PBENCH_SUBNET_DEFAULT=10.210.1.0/24
PBENCH_SUBNET_EGRESS=10.210.2.0/24
PBENCH_SUBNET_EDGE=10.210.3.0/24

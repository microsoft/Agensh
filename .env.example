# omcgitea — copy to .env.dev (or .env.prod) and fill in GITEA_ADMIN_PASSWORD.
# Profile isolation lives here: PROFILE + DATA_DIR + EDGE_HTTP_PORT must
# differ between dev/prod. See DESIGN §5.A.
PROFILE=dev
DATA_DIR=.claude-team-data/dev

GITEA_ADMIN_USER=chairman
GITEA_ADMIN_PASSWORD=changeme-please
# GITEA_HTTP_PORT only takes effect if you uncomment the loopback ports
# block in docker/docker-compose.yml; by default Gitea is reached via
# nginx-edge at gitea.${EDGE_DOMAIN}.
GITEA_HTTP_PORT=3000

# nginx-edge — public-facing reverse proxy. dev=28081, prod=28080.
EDGE_HTTP_PORT=28081
EDGE_DOMAIN=localhost

AGENTS=agent1,agent2
# Test-only sandbox repo. agent1 / agent2 + this repo are dedicated to e2e
# tests; tests freely write issues/PRs/branches here without cleanup.
REPOS=test-sandbox
REQUIRED_APPROVALS=1

# LLM — local proxy at host:4141 (Anthropic Messages API compatible)
# IMPORTANT: ANTHROPIC_MODEL must be a name your proxy actually serves. Hermes
# does NOT rewrite it (we use a custom_providers entry with api_mode=anthropic_messages
# so dot-vs-hyphen normalization is bypassed).
ANTHROPIC_BASE_URL=http://host.docker.internal:4141
ANTHROPIC_MODEL=claude-opus-4.6
ANTHROPIC_API_KEY=local-proxy-no-auth

HERMES_IMAGE=hermes-agent:local
GITEA_MCP_IMAGE=docker.gitea.com/gitea-mcp-server:latest

# Agent runtime. Default `claude` runs
# @agentclientprotocol/claude-agent-acp (97% prompt-cache hit in prod tests).
# Set to `copilot` to run the official Copilot CLI native ACP server with
# the deployment-owned ANTHROPIC_BASE_URL/API_KEY above; no GitHub login or
# hosted model is used. `hermes` remains a dormant compatibility option.
# For Copilot+GLM, point ANTHROPIC_BASE_URL at the OpenAI-compatible `/v1`
# endpoint and set ANTHROPIC_MODEL=SGLANG-GATEWAY-GLM-5.2-FP8-All.
# Set to `hermes` only as a dormant compatibility / A-B fallback option;
# hermes path has the cache-miss bug that prompted the switch. See
# CLAUDE.md "Agent selection" for rationale.
AGENT_KIND=claude
# Copilot BYOK provider protocol. GLM uses openai; Anthropic-compatible
# endpoints such as Opus use anthropic. Ignored unless AGENT_KIND=copilot.
COPILOT_PROVIDER_TYPE=openai

# R-cache-ttl: opt into Anthropic's 1h prompt-cache TTL (vs 5m default).
# Honored by the bundled Claude Agent SDK binary (AGENT_KIND=claude).
# Ignored by hermes path. Default ON. Set to 0 to fall back to 5m.
ENABLE_PROMPT_CACHING_1H=1

# omcgitea hermes-agent .env (rendered at container boot)
#
# Note on credential_pool.py:1232: env-seeded ANTHROPIC_API_KEY values that
# don't start with "sk-ant-api*" get auth_type=OAUTH. That classification
# is mostly cosmetic — _entry_needs_refresh() only triggers a refresh when
# expires_at_ms is set (never the case for env-seeded entries), and the
# actual request auth header is chosen by _is_oauth_token(token) which
# inspects the token shape. A non-"sk-ant-*" placeholder doesn't match the
# OAuth pattern, so it ends up sent as x-api-key correctly.
#
# HERMES_INFERENCE_PROVIDER must match config.yaml's `model.provider`
# ("anthropic") so the cache gate in run_agent.py:744-747 fires.
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL}
HERMES_INFERENCE_PROVIDER=anthropic
HERMES_MODEL=${ANTHROPIC_MODEL}
GITEA_HOST=${GITEA_HOST}
GITEA_TOKEN=${GITEA_TOKEN}
AGENT_NAME=${AGENT_NAME}

# omcgitea test profile — vitest integration suite isolation.
# Activated by `make <target> PROFILE=test` (or via tests/lib/env.ts which
# pins PROFILE=test). MUST stay separate from .env.dev so vitest's
# globalSetup/Teardown can never touch a long-running dev cluster.
# See DESIGN §5.A for the profile isolation contract.
PROFILE=test
DATA_DIR=.claude-team-data/test

GITEA_ADMIN_USER=chairman
# Placeholder for ephemeral test containers only — set a real value out-of-band.
GITEA_ADMIN_PASSWORD=REPLACE-local-test-admin-pw-1
GITEA_HTTP_PORT=3400

# Edge ports — picked from a high range (38xxx) to avoid collisions with
# random local services (28181 was already taken on a dev box).
EDGE_HTTP_PORT=38181
EDGE_MM_PORT=38182
EDGE_DOMAIN=localhost

# Smaller agent roster — tests don't need 30 agents and the boot cost
# matters here.
AGENTS=agent1,agent2,agent3,agent4,agent5
REPOS=test-sandbox
REQUIRED_APPROVALS=1

ROLES=lead=agent1;reviewer=agent2;coder=agent3,agent4,agent5

# LLM — point this at your own Anthropic-compatible endpoint when running
# LLM-gated tests (OMC_TEST_LLM=1). No real endpoint committed.
ANTHROPIC_BASE_URL=https://your-anthropic-endpoint.example
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_API_KEY=REPLACE-dummy-api-key

HERMES_IMAGE=hermes-agent:local
GITEA_MCP_IMAGE=docker.gitea.com/gitea-mcp-server:latest

# Placeholders for ephemeral test containers only — NOT real secrets.
# Replace with your own values out-of-band before any non-throwaway use.
SECRET_SERVICE_INTERNAL_AUTH=REPLACE-local-test-internal-auth
MYSQL_ROOT_PASSWORD=REPLACE-local-test-mysql-root-1
MYSQL_PASSWORD=REPLACE-local-test-mysql-app-1

# R8 Mattermost — placeholder admin password (ephemeral test instance only).
MATTERMOST_HOST=http://mattermost:8065
MATTERMOST_ADMIN_USER=mmadmin
MATTERMOST_ADMIN_PASSWORD=REPLACE-Local-Test-Mm-1
MATTERMOST_ADMIN_EMAIL=mmadmin@omcgitea.test
MATTERMOST_TEAM_NAME=omcgitea
MATTERMOST_TEAM_DISPLAY=omcgitea

# R-cache-bug: agent implementation. "claude" (default) | "hermes" (dormant)
AGENT_KIND=claude

+"""Cold native bridge hooks. No model transport/replay or data deletion.
+
+Each metadata HTTP probe is bounded. Native custodial wait is outside locks;
+existing paid work continues naturally. SIGTERM is the ONLY signal generated.
+Only local child PID/start/boot is examined; no stack, argv or process scan.
+"""
+from pathlib import Path
+import hashlib
+import http.client
+import json
+import os
+import signal
+import socket
+import subprocess
+import threading
+import time
+from native_bridge_protocol import BASE, checked_lifecycle
+
+def _digest(row):
+    return hashlib.sha256(json.dumps(row, ensure_ascii=False, separators=(',', ':')).encode()).hexdigest()
+
+def _start(pid):
+    raw = Path('/proc', str(pid), 'stat').read_bytes()
+    return int(raw[raw.rfind(b')') + 2:].split()[19])
+
+class _Unix(http.client.HTTPConnection):
+
+    def __init__(self, path):
+        super().__init__('localhost', timeout=32)
+        self.path = str(path)
+
+    def connect(self):
+        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.sock.settimeout(32)
+        self.sock.connect(self.path)
+SCHEMA = 'count14-native-cli-control-counts-v1'
+FIELDS = {'schema', 'sequence', 'pending_prompts', 'pending_tools', 'control_complete', 'observer_fault'}
+
+def checked_control(value):
+    if not (type(value) is dict and set(value) == FIELDS and (value['schema'] == SCHEMA) and (type(value['sequence']) is int) and (value['sequence'] >= 0) and all((type(value[k]) is int and 0 <= value[k] <= 65536 for k in ('pending_prompts', 'pending_tools'))) and (type(value['control_complete']) is bool) and (type(value['observer_fault']) is bool)):
+        raise ValueError('DYNTEAM_EXACT_NATIVE_CONTROL_COUNTER_FIELDS')
+    return value
+
+class NativeToolControlObserver:
+
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.prompts = set()
+        self.tools = set()
+        self.sequence = 0
+        self.fault = False
+
+    @staticmethod
+    def _id(value):
+        return type(value) is int and 0 <= value < 2 ** 63 or (type(value) is str and 0 < len(value) <= 256)
+
+    def _line(self, line, direction):
+        try:
+            if type(line) not in (str, bytes) or len(line) > 16 * 1024 * 1024:
+                raise ValueError('DYNTEAM_ACP_CONTROL_LINE_BOUND')
+            value = json.loads(line)
+            if type(value) is not dict:
+                raise ValueError('DYNTEAM_ACP_CONTROL_OBJECT')
+            method = value.get('method')
+            if direction == 'input':
+                if method == 'session/prompt':
+                    request_id = value.get('id')
+                    if not self._id(request_id) or request_id in self.prompts:
+                        raise ValueError('DYNTEAM_ACP_CONTROL_EXACT_PROMPT_ID')
+                    self.prompts.add(request_id)
+                return
+            if method is None:
+                request_id = value.get('id')
+                if self._id(request_id):
+                    self.prompts.discard(request_id)
+                return
+            if method != 'session/update':
+                return
+            params = value.get('params')
+            if type(params) is not dict:
+                raise ValueError('DYNTEAM_ACP_CONTROL_UPDATE_PARAMS')
+            update = params.get('update')
+            if type(update) is not dict:
+                raise ValueError('DYNTEAM_ACP_CONTROL_UPDATE_OBJECT')
+            kind = update.get('sessionUpdate')
+            if kind not in ('tool_call', 'tool_call_update'):
+                return
+            session_id = params.get('sessionId')
+            if type(session_id) is not str or not self._id(session_id):
+                raise ValueError('DYNTEAM_ACP_CONTROL_EXACT_SESSION_ID')
+            tool_id = update.get('toolCallId')
+            status = update.get('status')
+            if type(tool_id) is not str or not self._id(tool_id):
+                raise ValueError('DYNTEAM_ACP_CONTROL_EXACT_TOOL_ID')
+            key = (session_id, tool_id)
+            if status in ('completed', 'failed'):
+                self.tools.discard(key)
+            elif status in ('pending', 'in_progress') or (kind == 'tool_call' and status is None):
+                self.tools.add(key)
+            elif status is None and kind == 'tool_call_update':
+                pass
+            else:
+                raise ValueError('DYNTEAM_ACP_CONTROL_UNKNOWN_TOOL_STATUS')
+            if max(len(self.prompts), len(self.tools)) > 65536:
+                raise ValueError('DYNTEAM_ACP_CONTROL_COUNTER_BOUND')
+        except Exception:
+            self.fault = True
+
+    def observe(self, lines, direction):
+        if direction not in ('input', 'output') or type(lines) not in (list, tuple):
+            raise ValueError('DYNTEAM_ACP_CONTROL_FIXED_STREAM_DIRECTION')
+        with self.lock:
+            for line in lines:
+                if line in (b'', ''):
+                    continue
+                self.sequence += 1
+                self._line(line, direction)
+
+    def snapshot(self):
+        with self.lock:
+            return dict(schema=SCHEMA, sequence=self.sequence, pending_prompts=len(self.prompts), pending_tools=len(self.tools), control_complete=not self.fault, observer_fault=self.fault)
+
+class BridgeLifecycle:
+
+    def __init__(self, route):
+        if not (type(route) is dict and route.get('source_commit') == BASE and (route.get('schema') == 'count14-dynteam-router-cold-route-v1') and (route.get('mode') in ('production', 'smoke', 'own-zero'))):
+            raise ValueError('DYNTEAM_NATIVE_BRIDGE_FROZEN_ROUTE')
+        self.route = dict(route)
+        self.lock = threading.Lock()
+        self.children = {}
+        self.current = None
+
+    @classmethod
+    def from_environment(cls):
+        path = Path(os.environ.get('COUNT14_NATIVE_ROUTE', '/run/count14-dynteam/route.json'))
+        if path.resolve() != path or path.is_symlink():
+            raise ValueError('DYNTEAM_NATIVE_BRIDGE_ROUTE_CANONICAL')
+        if path.stat().st_size > 32768:
+            raise ValueError('DYNTEAM_NATIVE_BRIDGE_ROUTE_BOUND')
+        return cls(json.loads(path.read_bytes()))
+
+    def ready(self, stopping=None):
+        # Authenticated control-peer registration only, before any CLI. This
+        # does NOT claim BIRTH, archive, tool clear, model/session readiness or
+        # an empty baseline. Original SO_PEERCRED/Docker/namespace checks apply.
+        row=self._row('BRIDGE_READY',None,None,None)
+        while stopping is None or not stopping.is_set():
+            if self.request(row):return True
+            time.sleep(.1)
+        return False
+
+    def request(self, row):
+        checked_lifecycle(row)
+        raw = json.dumps(row, ensure_ascii=False, separators=(',', ':')).encode()
+        connection = _Unix(self.route['control_socket'])
+        try:
+            connection.request('POST', '/native-bridge-lifecycle', body=raw, headers={'Content-Type': 'application/json'})
+            response = connection.getresponse()
+            body = response.read(2049)
+            if response.status != 200 or len(body) > 2048:
+                return False
+            value = json.loads(body)
+            return value.get('schema') == 'count14-native-bridge-lifecycle-ack-v1' and value.get('binding_sha256') == hashlib.sha256(raw).hexdigest() and (value.get('allow') is True)
+        except Exception:
+            return False
+        finally:
+            connection.close()
+
+    def _row(self, event, proc, identity, turn, *, archive=False, reason='NONE'):
+        names = {'retire': 'RETIRE', 'terminated': 'TERMINATED', 'shutdown': 'SHUTDOWN', 'disconnect': 'DISCONNECT', 'tester_release': 'TESTER_RELEASE', 'startup_recovery': 'STARTUP_RECOVERY', 'NONE': 'NONE'}
+        with self.lock:
+            context = self.children.get(proc.pid) if proc is not None else self.current
+        if context is None:
+            context = dict(pid=0, start=0, account='STARTUP', turn='STARTUP')
+        if identity is not None:
+            context = {**context, 'account': identity['username']}
+        if turn is not None:
+            context = {**context, 'turn': turn.name}
+        t, role = (self.route['trajectory_id'], self.route['role_slot'])
+        return dict(schema='count14-native-bridge-lifecycle-v1', source_commit=BASE, trajectory_id=t, role_slot=role, logical_birth_sha256=_digest([BASE, t, role, context['account']]), native_turn_sha256=_digest([BASE, t, role, context['turn']]), event=event, child_namespace_pid=context['pid'], child_start_ticks=context['start'], child_running=proc is not None and proc.poll() is None, archive_durable=archive, end_kind=names.get(reason, 'OTHER'), tool_control=context['control_observer'].snapshot() if 'control_observer' in context else None)
+
+    def wait(self, event, proc=None, identity=None, turn=None, *, archive=False, reason='NONE'):

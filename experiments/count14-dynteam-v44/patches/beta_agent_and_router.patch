+            const total = decimal(d.total_paused_ns), now = process.hrtime.bigint();
+            if (lease !== WIRE_LEASE_NS || sampled > now || total > sampled || d.sequence < this.sequence || d.generation < this.generation || sampled < this.sampleAt || total < this.total) throw new Error('STATUS_REGRESSED_OR_INVALID');
+            if (now - sampled > LEASE_NS) throw new Error('STATUS_LEASE_EXPIRED');
+            this.sequence = d.sequence;
+            this.generation = d.generation;
+            this.sampleAt = sampled;
+            this.total = total;
+            const extrapolated = total + (d.paused ? now - sampled : 0n);
+            if (extrapolated > this.effectivePaused) this.effectivePaused = extrapolated;
+            return {
+                now,
+                paused: this.effectivePaused,
+                sequence: d.sequence,
+                generation: d.generation
+            };
+        } catch (error) {
+            const stale = error instanceof Error && error.message === 'STATUS_LEASE_EXPIRED';
+            this.staleOnly = (!this.faulted || this.staleOnly) && stale;
+            this.faulted = true;
+            throw new Error('BUDGET_PARK_STATUS_CUSTODY_UNKNOWN_NO_RECONNECT');
+        } finally{
+            if (fd !== undefined) closeSync(fd);
+        }
+    }
+    readRearm() {
+        let fd;
+        try {
+            const parent = lstatSync(dirname(this.path), {
+                bigint: true
+            });
+            if (!parent.isDirectory() || parent.uid !== BigInt(this.ownerUid) || parent.mode & 0o022n || `${parent.dev}:${parent.ino}` !== this.parentIdentity) throw new Error('REARM_PARENT');
+            fd = openSync(this.path + '.rearm', constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+            const a = fstatSync(fd, {
+                bigint: true
+            });
+            if (!a.isFile() || a.uid !== BigInt(this.ownerUid) || (a.mode & 0o777n) !== 0o444n || a.nlink > 1n || a.size < 1n || a.size > 4096n) throw new Error('REARM_FILE');
+            const raw = readFileSync(fd), b = fstatSync(fd, {
+                bigint: true
+            });
+            if (raw.length !== Number(a.size) || a.size !== b.size || a.mtimeNs !== b.mtimeNs || a.ctimeNs !== b.ctimeNs || a.uid !== b.uid || a.mode !== b.mode) throw new Error('REARM_CHANGED');
+            const d = JSON.parse(raw.toString('utf8'));
+            if (!d || Array.isArray(d) || Object.keys(d).sort().join() !== REARM_FIELDS.join() || d.schema !== 'agensh-checkpoint-clock-rearm-v1' || d.binding_sha256 !== this.bindingSha256 || !Number.isSafeInteger(d.sequence) || d.sequence < 1 || !Number.isSafeInteger(d.generation) || d.generation < 1 || d.sequence < this.rearmSequence) throw new Error('REARM_BINDING_OR_SEQUENCE');
+            return {
+                sequence: d.sequence,
+                generation: d.generation
+            };
+        } catch (error) {
+            if (error.code === 'ENOENT' && !this.rearmObserved) return undefined;
+            throw error;
+        } finally{
+            if (fd !== undefined) closeSync(fd);
+        }
+    }
+    hostCheckpointRearm() {
+        try {
+            const authorization = this.readRearm();
+            if (!authorization || authorization.sequence === this.rearmSequence) return;
+            if (this.faulted && !this.staleOnly) return;
+            const d = this.read();
+            if (d.sequence < authorization.sequence || d.generation !== authorization.generation) throw new Error('REARM_STATUS_NOT_CURRENT');
+            this.rearmSequence = authorization.sequence;
+            this.rearmObserved = true;
+            this.faulted = false;
+            this.staleOnly = false;
+            this.lastRx = d.now;
+            this.rxPaused = d.paused;
+        } catch  {
+            this.faulted = true;
+            this.staleOnly = false;
+        }
+    }
+    recordRx() {
+        this.hostCheckpointRearm();
+        if (this.faulted) return;
+        try {
+            const d = this.read();
+            this.lastRx = d.now;
+            this.rxPaused = d.paused;
+        } catch  {}
+    }
+    assertReadyForPrompt() {
+        this.hostCheckpointRearm();
+        if (!this.faulted) {
+            try {
+                this.read();
+            } catch  {}
+        }
+        if (this.faulted) throw new Error('BUDGET_PARK_STATUS_CUSTODY_UNKNOWN_NO_NEW_PROMPT');
+    }
+    silenceMs() {
+        this.hostCheckpointRearm();
+        if (this.faulted) return undefined;
+        try {
+            const d = this.read();
+            const elapsed = d.now - this.lastRx;
+            const suspended = d.paused - this.rxPaused;
+            return Number((elapsed > suspended ? elapsed - suspended : 0n) / NS_PER_MS);
+        } catch  {
+            this.faulted = true;
+            return undefined;
+        }
+    }
+}

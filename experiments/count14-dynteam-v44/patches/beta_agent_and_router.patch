+import { openSync, readFileSync, closeSync, fstatSync, constants, lstatSync, realpathSync } from 'node:fs';
+import { dirname, isAbsolute } from 'node:path';
+const NS_PER_MS = 1000000n;
+const WIRE_LEASE_NS = 10000000000n;
+const LEASE_NS = 120000000000n;
+const REARM_FIELDS = [
+    'schema',
+    'binding_sha256',
+    'sequence',
+    'generation'
+].sort();
+const fields = [
+    'schema',
+    'binding_sha256',
+    'sequence',
+    'generation',
+    'sampled_at_mono_ns',
+    'valid_for_ns',
+    'total_paused_ns',
+    'paused'
+].sort();
+export class BudgetPauseClock {
+    path;
+    bindingSha256;
+    ownerUid;
+    sequence = 0;
+    generation = 0;
+    sampleAt = 0n;
+    total = 0n;
+    effectivePaused = 0n;
+    lastRx = 0n;
+    rxPaused = 0n;
+    faulted = false;
+    staleOnly = false;
+    rearmSequence = 0;
+    rearmObserved = false;
+    parentIdentity;
+    constructor(path, bindingSha256, ownerUid){
+        this.path = path;
+        this.bindingSha256 = bindingSha256;
+        this.ownerUid = ownerUid;
+        if (!isAbsolute(path) || realpathSync(dirname(path)) !== dirname(path) || !/^[0-9a-f]{64}$/.test(bindingSha256) || !Number.isInteger(ownerUid) || ownerUid < 0) throw new Error('BUDGET_PARK_HOST_BINDING_INVALID');
+        const parent = lstatSync(dirname(path), {
+            bigint: true
+        });
+        this.parentIdentity = `${parent.dev}:${parent.ino}`;
+        if (!parent.isDirectory() || parent.uid !== BigInt(ownerUid) || parent.mode & 0o022n) throw new Error('BUDGET_PARK_HOST_PARENT_INVALID');
+        const initialRearm = this.readRearm();
+        if (initialRearm) {
+            this.rearmSequence = initialRearm.sequence;
+            this.rearmObserved = true;
+        }
+        this.recordRx();
+        this.assertReadyForPrompt();
+    }
+    read() {
+        let fd;
+        try {
+            const parent = lstatSync(dirname(this.path), {
+                bigint: true
+            });
+            if (!parent.isDirectory() || parent.uid !== BigInt(this.ownerUid) || parent.mode & 0o022n || `${parent.dev}:${parent.ino}` !== this.parentIdentity) throw new Error('PARENT_CHANGED');
+            fd = openSync(this.path, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+            const before = fstatSync(fd, {
+                bigint: true
+            });
+            if (!before.isFile() || before.uid !== BigInt(this.ownerUid) || (before.mode & 0o777n) !== 0o444n || before.size < 1n || before.size > 4096n) throw new Error('STATUS_FILE');
+            const raw = readFileSync(fd);
+            const after = fstatSync(fd, {
+                bigint: true
+            });
+            if (raw.length !== Number(before.size) || before.size !== after.size || before.mtimeNs !== after.mtimeNs || before.uid !== after.uid || before.mode !== after.mode) throw new Error('STATUS_CHANGED');
+            const d = JSON.parse(raw.toString('utf8'));
+            if (!d || Array.isArray(d) || Object.keys(d).sort().join() !== fields.join() || d.schema !== 'agensh-native-budget-pause-v1' || d.binding_sha256 !== this.bindingSha256 || !Number.isSafeInteger(d.sequence) || d.sequence < 1 || !Number.isSafeInteger(d.generation) || d.generation < 1 || typeof d.paused !== 'boolean') throw new Error('STATUS_SCHEMA');
+            const decimal = (x)=>{
+                if (typeof x !== 'string' || !/^(0|[1-9][0-9]{0,22})$/.test(x)) throw new Error('STATUS_INTEGER');
+                return BigInt(x);
+            };
